# ==== PostmortemAI server configuration ====
# REQUIRED: GOOGLE_API_KEY (embeddings) and PINECONE_API_KEY + PINECONE_INDEX
# (vector store). Postgres and Mongo are optional — they fall back to in-memory
# stores when their URLs are absent.

# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- AI provider (Google Gemini) — REQUIRED for embeddings ----
# Get a free key: https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Pinecone vector DB (REQUIRED, free: https://www.pinecone.io) ----
# Create an index with dimension 3072 and metric "cosine", then set:
PINECONE_API_KEY=
PINECONE_INDEX=postmortem-ai

# ---- PostgreSQL (free: https://neon.tech) ----
# Leave empty to use the in-memory SQL-like store.
DATABASE_URL=

# ---- MongoDB (free: https://www.mongodb.com/atlas) ----
# Leave empty to use the in-memory document store.
MONGODB_URI=mongodb+srv://ankitasingh692002_db_user:ZgnDTgN7IpL3sNkD@cluster0.d0b6psw.mongodb.net/
MONGODB_DB=postmortem_ai
